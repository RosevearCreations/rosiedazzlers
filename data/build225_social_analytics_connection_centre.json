{
  "build": 225,
  "date": "2026-07-07",
  "title": "Social & Analytics Connections Centre and DAIP external-service boundary",
  "admin_page": "/admin-integrations.html",
  "public_config_route": "/api/tracking_config",
  "admin_status_route": "/api/admin/integration_status",
  "cloudflare_secret_only": true,
  "website_tracking": {
    "master_switches": [
      "MARKETING_TRACKING_ENABLED",
      "MARKETING_TRACKING_MODE",
      "MARKETING_TRACKING_CONSENT_VERSION"
    ],
    "public_identifier_variables": [
      "META_PIXEL_ID",
      "GA4_MEASUREMENT_ID",
      "GOOGLE_ADS_CONVERSION_ID",
      "TIKTOK_PIXEL_ID",
      "LINKEDIN_PARTNER_ID",
      "PINTEREST_TAG_ID",
      "MICROSOFT_UET_TAG_ID"
    ],
    "consent_required": true,
    "excluded_routes": [
      "admin",
      "client",
      "detailer",
      "login",
      "account",
      "book",
      "progress",
      "payment",
      "checkout",
      "invoice",
      "complete",
      "privacy",
      "terms"
    ]
  },
  "social_publishing": {
    "current_direct_attempts": [
      "facebook",
      "instagram",
      "x"
    ],
    "manual_or_webhook_until_separate_review": [
      "tiktok",
      "linkedin",
      "youtube_shorts",
      "google_business_profile"
    ],
    "all_tokens_server_only": true
  },
  "daip": {
    "gate_c": "held",
    "external_service_connection_is_not_daip_implementation": true,
    "enabled_capabilities": [],
    "blocked_capabilities": [
      "storage",
      "upload",
      "download",
      "signed_links",
      "workers",
      "processing",
      "ai",
      "customer_media",
      "public_export",
      "gallery_social_handoff",
      "publishing"
    ]
  },
  "manual_tests": [
    "social_analytics_secret_boundary",
    "social_analytics_consent_gate",
    "daip_external_service_boundary"
  ]
}
